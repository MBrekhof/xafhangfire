<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Deterministic>false</Deterministic>
    <AssemblyVersion>1.0.*</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Configurations>Debug;Release;EasyTest</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Model.DesignedDiffs.xafml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Model.DesignedDiffs.xafml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="xafhangfire.Jobs.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CronExpressionDescriptor" Version="2.44.0" />
    <PackageReference Include="Cronos" Version="0.11.1" />
    <PackageReference Include="DevExpress.ExpressApp" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.Chart" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.CloneObject" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.CodeAnalysis" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.ConditionalAppearance" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.EFCore" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.Notifications" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.Office" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.PivotGrid" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.ReportsV2" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.Security" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.TreeListEditors" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.Validation" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.Scheduler" Version="26.1.6" />
    <PackageReference Include="DevExpress.ExpressApp.ViewVariantsModule" Version="26.1.6" />
    <PackageReference Include="DevExpress.Persistent.Base" Version="26.1.6" />
    <PackageReference Include="DevExpress.Persistent.BaseImpl.EFCore" Version="26.1.6" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.14" />
    <!-- SEC-001: EntityFrameworkCore.SqlServer -> Microsoft.Data.SqlClient 6.1.7 pulls in vulnerable Pkcs 9.0.11
         (fixed in 10.0.13). Drop when a SqlClient update moves it, or with the SqlServer design-time workaround. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>none</PrivateAssets>
      <IncludeAssets>all</IncludeAssets>
    </PackageReference>

  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\xafhangfire.Jobs\xafhangfire.Jobs.csproj" />
  </ItemGroup>
</Project>
